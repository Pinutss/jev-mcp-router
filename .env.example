# Provider: auto | local | mock | custom | jev
# auto = local heuristic, no agent required. Uses JEV + gateway only if both are set.
JEV_PROVIDER=auto

# JEV decision API (required for provider=jev)
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=jev-latest

# Gateway OpenAI-compatible (classic). If incomplete, the catalog resolves it.
# Examples: https://openrouter.ai/api/v1  https://api.openai.com/v1
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=
GATEWAY_MODELS=

# Multi-LLM catalog (keys stay in the environment, never in HTTP/MCP bodies)
JEV_MODELS_FILE=
JEV_LLM_DEFAULT=openrouter:anthropic/claude-sonnet-4
JEV_LLM_STRATEGY=named
# JEV_LLM_OPENROUTER_BASE_URL=
# JEV_LLM_OPENROUTER_API_KEY=
# JEV_LLM_OPENROUTER_MODELS=anthropic/claude-sonnet-4,openai/gpt-4o-mini

# Selector
JEV_MCP_MIN_RELEVANCE=0.15
JEV_MCP_MAX_TOOLS=8
JEV_MCP_BUDGET_TOKENS=800
JEV_MCP_MAX_CANDIDATES=50

# Security
JEV_REDACT_SECRETS=true
JEV_MCP_AUTH_TOKEN=

# Server
JEV_MCP_HOST=127.0.0.1
JEV_MCP_PORT=8080
JEV_MCP_TIMEOUT=30.0
